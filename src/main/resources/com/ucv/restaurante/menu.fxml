<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="620" prefWidth="960"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ucv.restaurante.controller.MenuController">
    <left>
        <VBox spacing="10" prefWidth="210" style="-fx-background-color: #1e293b;">
            <padding><Insets top="20" right="14" bottom="20" left="14"/></padding>
            <Label text="Restaurante" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblUsuario" text="Usuario | Rol" wrapText="true" style="-fx-text-fill: #cbd5e1;"/>
            <Separator/>
            <Button fx:id="btnProductos" text="Productos" maxWidth="Infinity" onAction="#onProductos"/>
            <Button fx:id="btnMesas" text="Mesas" maxWidth="Infinity" onAction="#onMesas"/>
            <Button fx:id="btnMeseros" text="Meseros" maxWidth="Infinity" onAction="#onMeseros"/>
            <Button fx:id="btnPedidos" text="Pedidos" maxWidth="Infinity" onAction="#onPedidos"/>
            <Button fx:id="btnFacturas" text="Facturas" maxWidth="Infinity" onAction="#onFacturas"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Salir" maxWidth="Infinity" onAction="#onSalir"/>
        </VBox>
    </left>
    <center>
        <Label text="Seleccione una opción del menú"/>
    </center>
</BorderPane>