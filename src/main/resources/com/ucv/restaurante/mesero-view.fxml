<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ucv.restaurante.controller.MeseroController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Restaurante | Meseros" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <HBox spacing="8">
        <TextField fx:id="txtFiltro" promptText="Buscar nombre o DNI" HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#onBuscar"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="+ Nuevo mesero" onAction="#onNuevo"/>
        <Button text="Editar" onAction="#onEditar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="Total: 0 mesero(s)"/>
    </HBox>
    <TableView fx:id="tablaMeseros" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombres" text="Mesero" prefWidth="200"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="120"/>
            <TableColumn fx:id="colTelefono" text="Telefono" prefWidth="130"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>