<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ucv.restaurante.controller.MesaController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Restaurante | Mesas" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <HBox spacing="8">
        <TextField fx:id="txtFiltro" promptText="Buscar número o estado" HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#onBuscar"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="+ Nueva mesa" onAction="#onNuevo"/>
        <Button text="Editar" onAction="#onEditar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="Total: 0 mesa(s)"/>
    </HBox>
    <TableView fx:id="tablaMesas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNumero" text="Numero" prefWidth="120"/>
            <TableColumn fx:id="colCapacidad" text="Capacidad" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>